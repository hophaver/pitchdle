# Copy to .env to override. Every value has a dev default.
DB_PATH=./data/pitchdle.db
ADMIN_PASSWORD=admin
# Public URL used for the QR code and share text. Leave empty to derive it from the request.
BASE_URL=
HOST=127.0.0.1
PORT=8000
# Points decay constant (bigger = more forgiving) and live-round timer in seconds.
DECAY_K=1.5
LIVE_SECONDS=25
