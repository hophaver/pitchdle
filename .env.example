# Copy to .env to override. Every value has a dev default.
# run.sh sources this file as shell, so quote any value that contains spaces.
DB_PATH=./data/pitchdle.db
ADMIN_PASSWORD=admin
HOST=127.0.0.1
PORT=8000
# Test account, created on startup. It gets a "Reset my data" item in its menu. Leave empty for none.
TEST_USERNAME=
TEST_PASSWORD=
# Test moderator, made (or its password reset) on startup like the test account. Leave empty for none, and keep
# it off anything public: moderators see every sign-up's details.
TEST_MODERATOR_USERNAME=
TEST_MODERATOR_PASSWORD=
# Guest answers count this much next to a player account's (1.0)...
GUEST_WEIGHT=0.5
# ...and together never make up more than this share of a card's crowd score once signed-in players answer it.
GUEST_MAX_SHARE=0.4
# A player account's and an investor account's answers count this much.
PLAYER_WEIGHT=1
INVESTOR_WEIGHT=2
# These four are defaults: the admin can change them on /moderate, and saved changes win over these.
# Outside reads from Admin, never on the game's path: AI models rate each startup, and AI search reads social
# media about it. These are paid APIs.
# One key for all three models through OpenRouter (the provider keys below are then ignored)...
OPENROUTER_API_KEY=
# ...or a key per provider; a model without its key is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Other models, if wanted. Blank uses the route's default: claude-opus-5-5, gpt-6-astra, grok-4.7 directly, or
# anthropic/claude-opus-5.5, openai/gpt-6-astra, x-ai/grok-4.7 on OpenRouter. Claude also searches Threads,
# LinkedIn, Reddit and Bluesky; Grok searches X.
CLAUDE_MODEL=
GPT_MODEL=
GROK_MODEL=
# Starting mode for a fresh database: demo (sample companies) or live (real startups). The admin toggle overrides it.
APP_MODE=demo
# Live mode looks for real startups on open feeds (Hacker News, Google News). Found ones show on the host
# dashboard and join the game once activated in Admin.
# Run discovery automatically when live mode is switched on (1) or only from the Admin button (0).
DISCOVER_AUTO=1
# Fields to search, comma-separated; one search per field.
DISCOVER_FIELDS="ocean tech,blue economy,aquaculture"
# Optional region added to every search, e.g. Finland or Nordic.
DISCOVER_REGION=
# Search depth: startups to add per field per run (1-10). Keep it small; it's there to populate the dashboard.
DISCOVER_DEPTH=3
# Most auto-found startups to keep in total.
DISCOVER_MAX=10
# Words or names to skip, comma-separated (whole words, matched against the name and headline).
DISCOVER_EXCLUDE=
# Words that make a *name* a fund, publisher or lab rather than a startup (name only). Empty = the defaults:
# fund,funds,capital,ventures,venture partners,vc,angels,investors,investments,holdings,equity,publisher,publishing,
# news,magazine,journal,podcast,laboratory,institute,university,foundation,association,accelerator,incubator,summit,
# conference,awards
# The event's partners (Redstone, A'Pelago) and big publishers are always skipped.
DISCOVER_EXCLUDE_NAMES=
# The OpenRouter key above also does every AI task but the reviews: it screens discovery hits (keeps real
# startups that fit the field and are based in the searched country, read from their website), writes their game
# cards (pitch, ask, facts) in the demo style, and fills each real startup's profile (raised, investors, stages,
# vision, country) and evidence scores from its website and news. Leave it empty to skip all of that.
# The model for all of those: pick a cheap one. Any OpenRouter model id that supports structured outputs.
# (The reviews, AI ratings and social media, run on CLAUDE_MODEL / GPT_MODEL / GROK_MODEL above.)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# The same key answers each startup's readiness checklists (TRL, KTH BRL, ocean impact), every answer with a quote
# that is checked against its sources. Without a key the host answers them by hand on the Dashboard card.
# Thesis criteria (A'Pelago's and Redstone's sector, geography, ticket size and stage band) live in rubric.json, not
# here: edit them in Admin > Thesis criteria. The shipped values are placeholders until the partners confirm theirs.
